{
  "name": "belfield-hunt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:secrets": "tsx scripts/check-bundle-secrets.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:secrets",
    "setup:apify": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/setup-apify.ts",
    "ingest:dataset": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/ingest-dataset.ts",
    "transit:refresh": "node --max-old-space-size=4096 ./node_modules/tsx/dist/cli.mjs scripts/build-transit.ts",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > lib/supabase/database.types.ts",
    "test:db": "vitest run -c vitest.integration.config.mts",
    "db:types:local": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "scrape:local": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/scrape-local.ts",
    "enrich:pending": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/enrich-pending.ts",
    "regeocode": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/regeocode.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-table": "^9.3.1",
    "apify-client": "^2.26.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.76.0",
    "maplibre-gl": "^6.19.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@turf/helpers": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fflate": "^0.8.3",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20.9"
  }
}
