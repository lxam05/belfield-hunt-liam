# ─────────────────────────────────────────────────────────────────────────────
# Belfield Hunt — environment variables.
# Copy to .env.local for local dev. NEVER commit real values.
# Only variables prefixed NEXT_PUBLIC_ are ever sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of the deployment (no trailing slash). Used for Apify/Telegram webhooks.
APP_URL=http://localhost:3000
# Shared group password typed on /login (with your name)
SITE_PASSWORD=

# Supabase (Project Settings → API). The anon key is public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role bypasses RLS. Server only (webhooks, cron, scripts).
SUPABASE_SERVICE_ROLE_KEY=

# Apify — console.apify.com/settings/integrations. Server only.
APIFY_TOKEN=
# Random 32+ chars, e.g. `openssl rand -hex 32`. Sent by Apify in the x-webhook-secret header.
APIFY_WEBHOOK_SECRET=

# Google Cloud key restricted to Geocoding API + Routes API. Server only.
# Leave empty to use the free straight-line + GTFS estimator.
GOOGLE_MAPS_SERVER_KEY=
# Hard monthly cap across all Google calls (kill switch). 0 disables Google entirely.
GOOGLE_MONTHLY_CALL_LIMIT=8000

# Optional — developer.nationaltransport.ie (GTFS-Realtime v2) for live departures.
NTA_API_KEY=

# Telegram bot (@BotFather). Chat id of the group (negative number for groups).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Random string; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# Map tiles (keyless). Swap for any MapLibre style URL.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Vercel sends `Authorization: Bearer $CRON_SECRET` to the daily cron route.
CRON_SECRET=

# Optional Web Push (generate with `pnpm dlx web-push generate-vapid-keys`).
# The public key is also exposed to the browser for subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
